# 复制为 goaihz/.env。不要提交真实密钥。

PORT=11315

# 真实模型适配器读取与公开仓库一致的 MiniMax 兼容变量。
# 切勿提交真实密钥；生产环境从 /etc/labtrace/labtrace.env（0600）读取。
LABTRACE_LLM_ENABLED=true
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.05
LLM_ENABLE_THINKING=false
LABTRACE_LLM_TIMEOUT_SECONDS=90
LABTRACE_LLM_MAX_ATTEMPTS=3
LABTRACE_LLM_MAX_TOKENS=3200
LABTRACE_LLM_ENABLE_THINKING=false
LABTRACE_LLM_DAILY_LIMIT=100
LABTRACE_LLM_EVIDENCE_CHARS=50000
LABTRACE_LLM_MAX_IMAGES=4
LABTRACE_LLM_MAX_IMAGE_BYTES=6291456

# 可选：OpenAI 兼容的多模态模型端点。
# VISION_BASE_URL=http://host.docker.internal:8000/v1
# VISION_API_KEY=replace-me
# VISION_MODEL=replace-with-your-vision-model-id
# VISION_API_TYPE=chat

CONFIDENCE_THRESHOLD=0.75
MAX_CONCURRENCY=2
MAX_AGENT_ITERATIONS=20
